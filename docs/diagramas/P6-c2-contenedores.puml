@startuml c2-contenedores
!include <C4/C4_Container>
title C2 - Diagrama de Contenedores - Plataforma de Contratistas Rurales
AddRelTag("dep", $lineStyle = DashedLine(), $legendText="dependencia de librería")
AddElementTag("lib", $bgColor="#7aa7d8", $legendText="librería (no es un contenedor ejecutable)")
Person(usuarios, "Usuarios", "Productor, Contratista, Agrónomo, Administrador")
System_Ext(keycloak, "Keycloak 26", "IdP en el compose (:8081). Realm agro, 4 roles, OIDC, JWT. Guarda sus datos en el esquema keycloak.")
System_Boundary(sis, "Plataforma de Contratistas Rurales (docker compose, red interna)") {
  Container(gateway, "API Gateway", "Spring Cloud Gateway + Spring Security", "Único punto de entrada (:8080). Valida el JWT, controla el rol por ruta y método, y rutea.")
  Container(campos, "ms-campos", "Java 21, Spring Boot 3.5", "Productores, establecimientos y lotes; clasifica la zona del lote; parámetros de zona.")
  Container(trabajos, "ms-trabajos", "Java 21, Spring Boot 3.5", "Orquesta la orden: agrónomos y recetas, postulaciones, ventana climática, asignación, ejecución y cierre.")
  Container(contratistas, "ms-contratistas", "Java 21, Spring Boot 3.5", "Contratistas, máquinas, aplicadores, habilitaciones, disponibilidad y reservas de agenda.")
  ContainerDb(db, "PostgreSQL 16", "Una instancia", "Esquemas campos, contratistas, trabajos y keycloak; un usuario por esquema.")
  Container(commons, "agro-commons", "JAR Maven", "Librería usada por los tres servicios: errores, excepciones, CurrentUser, Vigencia, GeoUtils.", $tags="lib")
}
System_Ext(georef, "Georef Argentina", "Ubicación y localidades")
System_Ext(meteo, "Open-Meteo", "Pronóstico horario y clima real")
Lay_R(campos, trabajos)
Lay_R(trabajos, contratistas)
Lay_D(trabajos, db)
Lay_R(db, commons)
Lay_D(campos, georef)
Lay_R(usuarios, keycloak)
Rel(usuarios, keycloak, "Login, obtiene JWT", "OIDC")
Rel(usuarios, gateway, "Invoca la API", "HTTPS/JSON + Bearer JWT")
Rel(gateway, keycloak, "Obtiene claves públicas", "JWKS")
Rel(gateway, campos, "/api/establecimientos, /api/lotes, /api/admin/zonas", "HTTP/JSON")
Rel(gateway, trabajos, "/api/ordenes, /api/agronomos, /api/admin/matriculas, /api/admin/umbrales", "HTTP/JSON")
Rel(gateway, contratistas, "/api/contratistas, /maquinas, /aplicadores, /habilitaciones, /agenda, /api/admin/habilitaciones", "HTTP/JSON")
Rel_L(trabajos, campos, "Datos del lote al crear la orden", "REST /internal + JWT propagado")
Rel_R(trabajos, contratistas, "Habilitación, disponibilidad, reserva y liberación de agenda", "REST /internal + JWT propagado")
Rel(campos, georef, "Ubicación y localidades", "HTTPS/JSON")
Rel(trabajos, meteo, "Pronóstico y clima real", "HTTPS/JSON")
Rel(campos, db, "Esquema campos", "JPA")
Rel(trabajos, db, "Esquema trabajos", "JPA")
Rel(contratistas, db, "Esquema contratistas", "JPA")
Rel(campos, commons, "usa", "Maven", $tags="dep")
Rel(trabajos, commons, "usa", "Maven", $tags="dep")
Rel(contratistas, commons, "usa", "Maven", $tags="dep")
SHOW_LEGEND()
@enduml
