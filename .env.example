# Plantilla de configuración. Copiar a .env (que NO se versiona) y reemplazar los change-me.
#   cp .env.example .env        (PowerShell: Copy-Item .env.example .env)

# ---- Secretos (obligatorios) ----
# PostgreSQL: administrador y un usuario por esquema
POSTGRES_PASSWORD=change-me
CAMPOS_DB_PASSWORD=change-me
CONTRATISTAS_DB_PASSWORD=change-me
TRABAJOS_DB_PASSWORD=change-me
KC_DB_PASSWORD=change-me

# Administrador de la consola de Keycloak (http://localhost:8081/admin)
KEYCLOAK_ADMIN_PASSWORD=change-me

# ---- Integraciones externas (opcionales; estos son los valores por defecto) ----
GEOREF_URL=https://apis.datos.gob.ar/georef/api
OPEN_METEO_URL=https://api.open-meteo.com
# Timeouts de los clientes HTTP (ms): conexión y lectura
HTTP_CONNECT_TIMEOUT_MS=2000
HTTP_READ_TIMEOUT_MS=8000

# ---- Reglas configurables por entorno (RN-12) ----
# Traslado (h) = distancia Haversine (km) x factor de ruta / velocidad media (km/h)
TRASLADO_FACTOR_RUTA=1.3
TRASLADO_VELOCIDAD_KMH=40

# ---- Esquema y datos de demostración ----
# create + always: recrea las tablas y carga data.sql en cada arranque (estado conocido).
# Para conservar los datos entre reinicios: DDL_AUTO=update y SQL_INIT_MODE=never
DDL_AUTO=create
SQL_INIT_MODE=always
